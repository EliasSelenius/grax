
/*

    targets:
        GL_TIMESTAMP
        GL_SAMPLES_PASSED
        GL_ANY_SAMPLES_PASSED
        GL_ANY_SAMPLES_PASSED_CONSERVATIVE
        GL_PRIMITIVES_GENERATED
        GL_TRANSFORM_FEEDBACK_PRIMITIVES_WRITTEN
        GL_TIME_ELAPSED

    glGetQuery pname:
        GL_CURRENT_QUERY
        GL_QUERY_COUNTER_BITS

    glGetQueryObject pname:
        GL_QUERY_RESULT
        GL_QUERY_RESULT_NO_WAIT
        GL_QUERY_RESULT_AVAILABLE

    void glGetQueryiv(GLenum target, GLenum pname, GLint* params);
    void glGetQueryIndexediv(GLenum target, GLuint index, GLenum pname, GLint* params);

    void glGenQueries(GLsizei n, GLuint* ids);
    void glDeleteQueries(GLsizei n, const GLuint* ids);
    GLboolean glIsQuery(GLuint id);

    void glObjectLabel(GL_QUERY, GLuint name, GLsizei length, const GLchar* label);

    void glGetQueryObjectui64v(GLuint id, GLenum pname, GLuint64* params);
    void glGetQueryObjecti64v(GLuint id, GLenum pname, GLint64* params);
    void glGetQueryObjectuiv(GLuint id, GLenum pname, GLuint* params);
    void glGetQueryObjectiv(GLuint id, GLenum pname, GLint* params);

    void glQueryCounter(GLuint id, GLenum target);

    void glBeginQuery(GLenum target, GLuint id);
    void glBeginQueryIndexed(GLenum target, GLuint index, GLuint id);
    void glEndQuery(GLenum target);
    void glEndQueryIndexed(GLenum target, GLuint index);

    void glGetQueryBufferObjectuiv  (GLuint id, GLuint buffer, GLenum pname, GLintptr offset);
    void glGetQueryBufferObjectui64v(GLuint id, GLuint buffer, GLenum pname, GLintptr offset);
    void glGetQueryBufferObjecti64v (GLuint id, GLuint buffer, GLenum pname, GLintptr offset);
    void glGetQueryBufferObjectiv   (GLuint id, GLuint buffer, GLenum pname, GLintptr offset);

*/


uint32 ogl_query_current(GLenum target) {
    uint32 params = 0;
    glGetQueryiv(target, GL_CURRENT_QUERY, *params);
    return params;
}

int32 ogl_query_bits(GLenum target) {
    int32 params = 0;
    glGetQueryiv(target, GL_QUERY_COUNTER_BITS, *params);
    return params;
}


bool ogl_query_result_available(GLuint id) {
    GLuint params = GL_FALSE;
    glGetQueryObjectuiv(id, GL_QUERY_RESULT_AVAILABLE, *params);
    return params == GL_TRUE;
}

uint64 ogl_query_result_nowait(GLuint id) {
    GLuint64 params = 0;
    glGetQueryObjectui64v(id, GL_QUERY_RESULT_NO_WAIT, *params);
    return params;
}

uint64 ogl_query_result(GLuint id) {
    GLuint64 params = 0;
    glGetQueryObjectui64v(id, GL_QUERY_RESULT, *params);
    return params;
}


const GPU_Profiler_Frame_Count = 60*3;

GPU_Profiler profiler;

struct GPU_Profiler {
    Frame_Timestamps frame_timestamps;

    uint32 frame_index;
    GPU_Profiler_Frame[GPU_Profiler_Frame_Count] frames;
}

struct GPU_Profiler_Frame {
    uint64[..] timestamps;
    uint64 total_time;
}

void profiler_begin_frame() {
    
}

void profiler_timestamp() {
    ogl_query_timestamp("profiler_timestamp");
}

void profiler_end_frame() {
    GPU_Profiler_Frame* frame = profiler.frames + profiler.frame_index;

    if !frame.timestamps  frame.timestamps = list_create(sizeof uint64);
    list_clear(frame.timestamps);

    uint64 base_ns = ogl_query_result(profiler.frame_timestamps.queries[0]);
    for 1 .. profiler.frame_timestamps.timestamp_count {
        uint64 ns = ogl_query_result(profiler.frame_timestamps.queries[it]) - base_ns;
        // if it == 0  frame
        list_add(*frame.timestamps, *ns);
    }

    if list_length(frame.timestamps) {
        frame.total_time = @(list_last_item(frame.timestamps) as uint64*);
    }

    profiler.frame_timestamps.timestamp_count = 0;
    profiler.frame_index = (profiler.frame_index + 1) % GPU_Profiler_Frame_Count;
}

struct Frame_Timestamps {
    GLuint* queries;
    uint32 query_count;

    uint32 timestamp_count;
}

// void ogl_query_timestamp(uint32* q) {
//     if !glIsQuery(@q) {
//         glGenQueries(1, q);
//     }

//     glQueryCounter(id, GL_TIMESTAMP);
// }

void ogl_query_timestamp(char* label) {

    Frame_Timestamps* fts = *profiler.frame_timestamps;

    if fts.timestamp_count == fts.query_count {
        fts.query_count += 1;
        fts.queries = realloc(fts.queries, fts.query_count * sizeof GLuint);
        glGenQueries(1, fts.queries + fts.timestamp_count);
    }

    GLuint id = fts.queries[fts.timestamp_count++];
    glQueryCounter(id, GL_TIMESTAMP);

    GLsizei length = -1; // null-terminated
    glObjectLabel(GL_QUERY, id, length, label);
}

void display_profiler(UI_Rect rect) {
    uint32 frame_count = GPU_Profiler_Frame_Count;

    uint64 total_ns = 0;
    uint64 max_ns = 0;
    uint64 min_ns = uint64_max;

    for uint32 it: 0 .. frame_count {
        let frame = profiler.frames[it];
        uint64 ns = frame.total_time;
        max_ns = max(ns, max_ns);
        min_ns = min(ns, min_ns);
        total_ns += ns;
    }

    float ns2ms(uint64 ns) {
        return (ns as float64 / 1_000_000.0) as float;
    }

    float avg_ms = (total_ns as float64 / frame_count / 1_000_000.0) as float;
    float gh = 0.05;
    draw_text(point(rect, 1,  0) + {gh/4.0, 0}, gh, to_string(avg_ms), White);
    draw_text(point(rect, 1,  1) + {gh/4.0, 0}, gh, to_string(ns2ms(max_ns)), White);
    draw_text(point(rect, 1, -1) + {gh/4.0, 0}, gh, to_string(ns2ms(min_ns)), White);

    float px = 2.0 / app.window_height;

    // uint32 ns_res = 1_000_000;
    // uint32 divis = 10;
    // for 0 .. divis {
    //     UI_Rect r0 = div_y(rect, divis, it);
    //     draw_rect(pad(r0, 2.0*px), opacity(Black, 0.8));
    // }

    draw_rect(rect, opacity(Black, 0.8));

    for uint32 it: 0 .. frame_count {
        let frame = profiler.frames[it];
        uint64 ns = frame.total_time;

        // float64 s = ns / max_ns as float64;
        float s = map(ns as float, min_ns as float, max_ns as float, 0, 1);

        UI_Rect r0 = div_x(rect, frame_count, it);
        UI_Rect r1 = scale_pivot(r0, 1, s as float, 0, -1);

        draw_rect(r1, opacity(White, 0.9));
    }
}

void measure_frametime() {
    UI_Rect rect_total;

    const sample_count = 60*3;
    static float32* samples = calloc(1, sample_count * sizeof float32);
    static uint32 sample_index = 0;

    samples[sample_index++ % sample_count] = app.frame_time as float32;

    float32 dt_min = 99999999999999999999.0;
    float32 dt_max = 0;
    float32 dt_avg = 0;

    for 0 .. sample_count {
        let dt = samples[it];
        dt_min = min(dt_min, dt);
        dt_max = max(dt_max, dt);
        dt_avg += dt;
    }

    dt_avg /= sample_count;

    // rect_total.size.x

    float32 column_width = 2.0 / sample_count;
    for 0 .. sample_count {
        let dt = samples[it];
        vec2 size = { column_width, dt / (3.0*dt_avg) };
        vec2 pos = make_vec(column_width/2 + size.x * it - 1, size.y/2.0 - 1);
        draw_rect(pos, size, opacity(White, 0.3));
    }

    void dl(float32 dt, dt_avg, Color color) {
        let micro_sec = round(dt * 1000_000) as uint64;
        vec2 size = { 2, 0.005 };
        vec2 pos  = { 0, dt / (3.0*dt_avg) - 1 };
        draw_rect(pos, size, color);
        const text_height = 0.05;
        draw_text(pos + make_vec(1 + text_height/2.0, 0), text_height, to_string(micro_sec), color);
    }

    dl(dt_max, dt_avg, Red);
    dl(dt_min, dt_avg, Blue);
    dl(dt_avg, dt_avg, Green);
    // dl(app.frame_time as float32, dt_avg, Yellow);
}

struct OGL_Trace_Entry {
    char* procname;
    uint64 ns;
}

void append_ogl_trace(char* name) {

    OGL_Trace_Entry[..] ogl_trace;

    OGL_Trace_Entry en = {
        procname = name
    };
    list_add(*ogl_trace, *en);
}

void hijack_opengl() {
    static proc_glDrawTransformFeedbackStreamInstanced         _glDrawTransformFeedbackStreamInstanced        = glDrawTransformFeedbackStreamInstanced;        // void(GLenum mode, GLuint id, GLuint stream, GLsizei instancecount);
    static proc_glDrawElementsInstancedBaseInstance            _glDrawElementsInstancedBaseInstance           = glDrawElementsInstancedBaseInstance;           // void(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount, GLuint baseinstance);
    static proc_glDrawArraysInstancedBaseInstance              _glDrawArraysInstancedBaseInstance             = glDrawArraysInstancedBaseInstance;             // void(GLenum mode, GLint first, GLsizei count, GLsizei instancecount, GLuint baseinstance);
    static proc_glDrawTransformFeedbackStream                  _glDrawTransformFeedbackStream                 = glDrawTransformFeedbackStream;                 // void(GLenum mode, GLuint id, GLuint stream);
    static proc_glDrawArraysIndirect                           _glDrawArraysIndirect                          = glDrawArraysIndirect;                          // void(GLenum mode, /*const*/ void* indirect);
    static proc_glDrawElementsInstancedBaseVertex              _glDrawElementsInstancedBaseVertex             = glDrawElementsInstancedBaseVertex;             // void(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount, GLint basevertex);
    static proc_glDrawTransformFeedback                        _glDrawTransformFeedback                       = glDrawTransformFeedback;                       // void(GLenum mode, GLuint id);
    static proc_glDrawElements                                 _glDrawElements                                = glDrawElements;                                // void(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices);
    static proc_glDrawTransformFeedbackInstanced               _glDrawTransformFeedbackInstanced              = glDrawTransformFeedbackInstanced;              // void(GLenum mode, GLuint id, GLsizei instancecount);
    static proc_glDrawArrays                                   _glDrawArrays                                  = glDrawArrays;                                  // void(GLenum mode, GLint first, GLsizei count);
    static proc_glDrawElementsInstanced                        _glDrawElementsInstanced                       = glDrawElementsInstanced;                       // void(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount);
    static proc_glDrawRangeElements                            _glDrawRangeElements                           = glDrawRangeElements;                           // void(GLenum mode, GLuint start, GLuint end, GLsizei count, GLenum _type, /*const*/ void* indices);
    static proc_glDrawElementsIndirect                         _glDrawElementsIndirect                        = glDrawElementsIndirect;                        // void(GLenum mode, GLenum _type, /*const*/ void* indirect);
    static proc_glDrawArraysInstanced                          _glDrawArraysInstanced                         = glDrawArraysInstanced;                         // void(GLenum mode, GLint first, GLsizei count, GLsizei instancecount);
    static proc_glDrawRangeElementsBaseVertex                  _glDrawRangeElementsBaseVertex                 = glDrawRangeElementsBaseVertex;                 // void(GLenum mode, GLuint start, GLuint end, GLsizei count, GLenum _type, /*const*/ void* indices, GLint basevertex);
    static proc_glDrawElementsInstancedBaseVertexBaseInstance  _glDrawElementsInstancedBaseVertexBaseInstance = glDrawElementsInstancedBaseVertexBaseInstance; // void(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount, GLint basevertex, GLuint baseinstance);
    static proc_glDrawElementsBaseVertex                       _glDrawElementsBaseVertex                      = glDrawElementsBaseVertex;                      // void(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLint basevertex);
    static proc_glMultiDrawArraysIndirectCount                 _glMultiDrawArraysIndirectCount                = glMultiDrawArraysIndirectCount;                // void(GLenum mode, /*const*/ void* indirect, GLintptr drawcount, GLsizei maxdrawcount, GLsizei stride);
    static proc_glMultiDrawElementsIndirect                    _glMultiDrawElementsIndirect                   = glMultiDrawElementsIndirect;                   // void(GLenum mode, GLenum _type, /*const*/ void* indirect, GLsizei drawcount, GLsizei stride);
    static proc_glMultiDrawElementsBaseVertex                  _glMultiDrawElementsBaseVertex                 = glMultiDrawElementsBaseVertex;                 // void(GLenum mode, /*const*/ GLsizei* count, GLenum _type, /*const*/ void*/*const*/* indices, GLsizei drawcount, /*const*/ GLint* basevertex);
    static proc_glMultiDrawArrays                              _glMultiDrawArrays                             = glMultiDrawArrays;                             // void(GLenum mode, /*const*/ GLint* first, /*const*/ GLsizei* count, GLsizei drawcount);
    static proc_glMultiDrawElementsIndirectCount               _glMultiDrawElementsIndirectCount              = glMultiDrawElementsIndirectCount;              // void(GLenum mode, GLenum _type, /*const*/ void* indirect, GLintptr drawcount, GLsizei maxdrawcount, GLsizei stride);
    static proc_glMultiDrawArraysIndirect                      _glMultiDrawArraysIndirect                     = glMultiDrawArraysIndirect;                     // void(GLenum mode, /*const*/ void* indirect, GLsizei drawcount, GLsizei stride);
    static proc_glMultiDrawElements                            _glMultiDrawElements                           = glMultiDrawElements;                           // void(GLenum mode, /*const*/ GLsizei* count, GLenum _type, /*const*/ void*/*const*/* indices, GLsizei drawcount);
    static proc_glDispatchComputeIndirect                      _glDispatchComputeIndirect                     = glDispatchComputeIndirect;                     // void(GLintptr indirect);
    static proc_glDispatchCompute                              _glDispatchCompute                             = glDispatchCompute;                             // void(GLuint num_groups_x, GLuint num_groups_y, GLuint num_groups_z);

    void wrap_glDrawTransformFeedbackStreamInstanced(GLenum mode, GLuint id, GLuint stream, GLsizei instancecount)                                                                           {_glDrawTransformFeedbackStreamInstanced(mode, id, stream, instancecount);                                             append_ogl_trace("glDrawTransformFeedbackStreamInstanced");}
    void wrap_glDrawElementsInstancedBaseInstance(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount, GLuint baseinstance)                             {_glDrawElementsInstancedBaseInstance(mode, count, _type, indices, instancecount, baseinstance);                       append_ogl_trace("glDrawElementsInstancedBaseInstance");}
    void wrap_glDrawArraysInstancedBaseInstance(GLenum mode, GLint first, GLsizei count, GLsizei instancecount, GLuint baseinstance)                                                         {_glDrawArraysInstancedBaseInstance(mode, first, count, instancecount, baseinstance);                                  append_ogl_trace("glDrawArraysInstancedBaseInstance");}
    void wrap_glDrawTransformFeedbackStream(GLenum mode, GLuint id, GLuint stream)                                                                                                           {_glDrawTransformFeedbackStream(mode, id, stream);                                                                     append_ogl_trace("glDrawTransformFeedbackStream");}
    void wrap_glDrawArraysIndirect(GLenum mode, /*const*/ void* indirect)                                                                                                                    {_glDrawArraysIndirect(mode, indirect);                                                                                append_ogl_trace("glDrawArraysIndirect");}
    void wrap_glDrawElementsInstancedBaseVertex(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount, GLint basevertex)                                  {_glDrawElementsInstancedBaseVertex(mode, count, _type, indices, instancecount, basevertex);                           append_ogl_trace("glDrawElementsInstancedBaseVertex");}
    void wrap_glDrawTransformFeedback(GLenum mode, GLuint id)                                                                                                                                {_glDrawTransformFeedback(mode, id);                                                                                   append_ogl_trace("glDrawTransformFeedback");}
    void wrap_glDrawElements(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices)                                                                                              {_glDrawElements(mode, count, _type, indices);                                                                         append_ogl_trace("glDrawElements");}
    void wrap_glDrawTransformFeedbackInstanced(GLenum mode, GLuint id, GLsizei instancecount)                                                                                                {_glDrawTransformFeedbackInstanced(mode, id, instancecount);                                                           append_ogl_trace("glDrawTransformFeedbackInstanced");}
    void wrap_glDrawArrays(GLenum mode, GLint first, GLsizei count)                                                                                                                          {_glDrawArrays(mode, first, count);                                                                                    append_ogl_trace("glDrawArrays");}
    void wrap_glDrawElementsInstanced(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount)                                                              {_glDrawElementsInstanced(mode, count, _type, indices, instancecount);                                                 append_ogl_trace("glDrawElementsInstanced");}
    void wrap_glDrawRangeElements(GLenum mode, GLuint start, GLuint end, GLsizei count, GLenum _type, /*const*/ void* indices)                                                               {_glDrawRangeElements(mode, start, end, count, _type, indices);                                                        append_ogl_trace("glDrawRangeElements");}
    void wrap_glDrawElementsIndirect(GLenum mode, GLenum _type, /*const*/ void* indirect)                                                                                                    {_glDrawElementsIndirect(mode, _type, indirect);                                                                       append_ogl_trace("glDrawElementsIndirect");}
    void wrap_glDrawArraysInstanced(GLenum mode, GLint first, GLsizei count, GLsizei instancecount)                                                                                          {_glDrawArraysInstanced(mode, first, count, instancecount);                                                            append_ogl_trace("glDrawArraysInstanced");}
    void wrap_glDrawRangeElementsBaseVertex(GLenum mode, GLuint start, GLuint end, GLsizei count, GLenum _type, /*const*/ void* indices, GLint basevertex)                                   {_glDrawRangeElementsBaseVertex(mode, start, end, count, _type, indices, basevertex);                                  append_ogl_trace("glDrawRangeElementsBaseVertex");}
    void wrap_glDrawElementsInstancedBaseVertexBaseInstance(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLsizei instancecount, GLint basevertex, GLuint baseinstance) {_glDrawElementsInstancedBaseVertexBaseInstance(mode, count, _type, indices, instancecount, basevertex, baseinstance); append_ogl_trace("glDrawElementsInstancedBaseVertexBaseInstance");}
    void wrap_glDrawElementsBaseVertex(GLenum mode, GLsizei count, GLenum _type, /*const*/ void* indices, GLint basevertex)                                                                  {_glDrawElementsBaseVertex(mode, count, _type, indices, basevertex);                                                   append_ogl_trace("glDrawElementsBaseVertex");}
    void wrap_glMultiDrawArraysIndirectCount(GLenum mode, /*const*/ void* indirect, GLintptr drawcount, GLsizei maxdrawcount, GLsizei stride)                                                {_glMultiDrawArraysIndirectCount(mode, indirect, drawcount, maxdrawcount, stride);                                     append_ogl_trace("glMultiDrawArraysIndirectCount");}
    void wrap_glMultiDrawElementsIndirect(GLenum mode, GLenum _type, /*const*/ void* indirect, GLsizei drawcount, GLsizei stride)                                                            {_glMultiDrawElementsIndirect(mode, _type, indirect, drawcount, stride);                                               append_ogl_trace("glMultiDrawElementsIndirect");}
    void wrap_glMultiDrawElementsBaseVertex(GLenum mode, /*const*/ GLsizei* count, GLenum _type, /*const*/ void*/*const*/* indices, GLsizei drawcount, /*const*/ GLint* basevertex)          {_glMultiDrawElementsBaseVertex(mode, count, _type, indices, drawcount, basevertex);                                   append_ogl_trace("glMultiDrawElementsBaseVertex");}
    void wrap_glMultiDrawArrays(GLenum mode, /*const*/ GLint* first, /*const*/ GLsizei* count, GLsizei drawcount)                                                                            {_glMultiDrawArrays(mode, first, count, drawcount);                                                                    append_ogl_trace("glMultiDrawArrays");}
    void wrap_glMultiDrawElementsIndirectCount(GLenum mode, GLenum _type, /*const*/ void* indirect, GLintptr drawcount, GLsizei maxdrawcount, GLsizei stride)                                {_glMultiDrawElementsIndirectCount(mode, _type, indirect, drawcount, maxdrawcount, stride);                            append_ogl_trace("glMultiDrawElementsIndirectCount");}
    void wrap_glMultiDrawArraysIndirect(GLenum mode, /*const*/ void* indirect, GLsizei drawcount, GLsizei stride)                                                                            {_glMultiDrawArraysIndirect(mode, indirect, drawcount, stride);                                                        append_ogl_trace("glMultiDrawArraysIndirect");}
    void wrap_glMultiDrawElements(GLenum mode, /*const*/ GLsizei* count, GLenum _type, /*const*/ void*/*const*/* indices, GLsizei drawcount)                                                 {_glMultiDrawElements(mode, count, _type, indices, drawcount);                                                         append_ogl_trace("glMultiDrawElements");}
    void wrap_glDispatchComputeIndirect(GLintptr indirect)                                                                                                                                   {_glDispatchComputeIndirect(indirect);                                                                                 append_ogl_trace("glDispatchComputeIndirect");}
    void wrap_glDispatchCompute(GLuint num_groups_x, GLuint num_groups_y, GLuint num_groups_z)                                                                                               {_glDispatchCompute(num_groups_x, num_groups_y, num_groups_z);                                                         append_ogl_trace("glDispatchCompute");}

    glDrawTransformFeedbackStreamInstanced         = wrap_glDrawTransformFeedbackStreamInstanced;
    glDrawElementsInstancedBaseInstance            = wrap_glDrawElementsInstancedBaseInstance;
    glDrawArraysInstancedBaseInstance              = wrap_glDrawArraysInstancedBaseInstance;
    glDrawTransformFeedbackStream                  = wrap_glDrawTransformFeedbackStream;
    glDrawArraysIndirect                           = wrap_glDrawArraysIndirect;
    glDrawElementsInstancedBaseVertex              = wrap_glDrawElementsInstancedBaseVertex;
    glDrawTransformFeedback                        = wrap_glDrawTransformFeedback;
    glDrawElements                                 = wrap_glDrawElements;
    glDrawTransformFeedbackInstanced               = wrap_glDrawTransformFeedbackInstanced;
    glDrawArrays                                   = wrap_glDrawArrays;
    glDrawElementsInstanced                        = wrap_glDrawElementsInstanced;
    glDrawRangeElements                            = wrap_glDrawRangeElements;
    glDrawElementsIndirect                         = wrap_glDrawElementsIndirect;
    glDrawArraysInstanced                          = wrap_glDrawArraysInstanced;
    glDrawRangeElementsBaseVertex                  = wrap_glDrawRangeElementsBaseVertex;
    glDrawElementsInstancedBaseVertexBaseInstance  = wrap_glDrawElementsInstancedBaseVertexBaseInstance;
    glDrawElementsBaseVertex                       = wrap_glDrawElementsBaseVertex;
    glMultiDrawArraysIndirectCount                 = wrap_glMultiDrawArraysIndirectCount;
    glMultiDrawElementsIndirect                    = wrap_glMultiDrawElementsIndirect;
    glMultiDrawElementsBaseVertex                  = wrap_glMultiDrawElementsBaseVertex;
    glMultiDrawArrays                              = wrap_glMultiDrawArrays;
    glMultiDrawElementsIndirectCount               = wrap_glMultiDrawElementsIndirectCount;
    glMultiDrawArraysIndirect                      = wrap_glMultiDrawArraysIndirect;
    glMultiDrawElements                            = wrap_glMultiDrawElements;
    glDispatchComputeIndirect                      = wrap_glDispatchComputeIndirect;
    glDispatchCompute                              = wrap_glDispatchCompute;
}

